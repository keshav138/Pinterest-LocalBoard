{
  "manifest_version": 3,
  "name": "Pinterest LocalBoard A4",
  "version": "2.1.0",
  "description": "Collect a Pinterest board and lay it out on A4 sheets (PDF/PNG).",
  "homepage_url": "https://github.com/thetejasagrawal/Pinterest-LocalBoard",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Open this board in A4 layout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://pinterest.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://pinterest.com/*", "https://*.pinterest.com/*"],
      "js": ["vendor/jszip.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/localboard-logo.png"],
      "matches": ["https://pinterest.com/*", "https://*.pinterest.com/*"]
    }
  ]
}
